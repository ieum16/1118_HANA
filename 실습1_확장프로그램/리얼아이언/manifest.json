{
  "manifest_version": 3,
  "name": "이번달 할 일 작성기",
  "description": "월별 할 일을 관리하고 직접 입력한 환율로 원화 금액을 계산하세요.",
  "version": "1.3.0",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/calendar-16.png",
    "32": "icons/calendar-32.png",
    "48": "icons/calendar-48.png",
    "128": "icons/calendar-128.png"
  },
  "action": {
    "default_title": "이번달 할 일 작성기",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/calendar-16.png",
      "32": "icons/calendar-32.png"
    }
  }
}
