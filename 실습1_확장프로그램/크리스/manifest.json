{
  "manifest_version": 3,
  "name": "오늘 할 일 작성기",
  "version": "1.3.0",
  "description": "오늘 할 일을 추가하고 완료와 마감일까지 간편하게 관리하세요.",
  "permissions": ["storage"],
  "host_permissions": ["https://api.stock.naver.com/*"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "오늘 할 일 작성기",
    "default_popup": "popup.html"
  }
}
