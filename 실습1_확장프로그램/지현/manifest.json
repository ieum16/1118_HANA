{
  "manifest_version": 3,
  "name": "토벌? 무서워랏~",
  "version": "1.0.0",
  "description": "몽쪽이와 함께 하는 투두리스트",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "토벌? 무서워랏~",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
