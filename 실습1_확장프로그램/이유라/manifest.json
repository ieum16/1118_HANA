{
  "manifest_version": 3,
  "name": "오늘 할 일 작성기 ♡",
  "version": "1.2.0",
  "description": "할 일과 Gmail 메일을 정리하고 원화 환율과 오늘의 날씨를 확인하세요.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "오늘 할 일 작성기 ♡",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "permissions": ["storage"],
  "host_permissions": ["https://api.frankfurter.dev/*", "https://api.open-meteo.com/*"],
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["gmail.js"],
      "css": ["gmail.css"]
    }
  ]
}
