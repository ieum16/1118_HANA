{
  "manifest_version": 3,
  "name": "오늘 할 일 작성기",
  "version": "1.3.0",
  "description": "할 일과 마감일을 등록하고 오늘, 예정, 지연, 완료 일정을 확인하세요.",
  "action": {
    "default_title": "오늘 할 일 작성기",
    "default_popup": "popup.html"
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*"
      ],
      "js": [
        "gmail.js"
      ],
      "css": [
        "gmail.css"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://api.frankfurter.dev/*"
  ]
}
