{
  "manifest_version": 3,
  "name": "언니 잊지마!",
  "version": "1.1.1",
  "description": "고양이와 함께 챙기는 일주일의 할 일. 마감이 가까운 순서로 확인하세요.",
  "permissions": [
    "storage"
  ],
  "icons": {
    "16": "icons/cat-16.png",
    "32": "icons/cat-32.png",
    "48": "icons/cat-48.png",
    "128": "icons/cat-128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/cat-16.png",
      "32": "icons/cat-32.png",
      "48": "icons/cat-48.png",
      "128": "icons/cat-128.png"
    },
    "default_title": "언니 잊지마!",
    "default_popup": "popup.html"
  }
}
