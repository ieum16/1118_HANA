{
  "manifest_version": 3,
  "name": "일해라!",
  "description": "치이카와, 하치와레, 우사기와 함께 할 일을 정리해요.",
  "version": "1.0.0",
  "permissions": ["storage"],
  "host_permissions": ["https://api.frankfurter.dev/*"],
  "action": {
    "default_title": "일해라!",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "images/icon-16.png",
      "32": "images/icon-32.png"
    }
  },
  "icons": {
    "16": "images/icon-16.png",
    "32": "images/icon-32.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  }
}
